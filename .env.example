# Copy this file to .env. Never commit .env or share its values.
# Use a unique password with at least 12 characters.
NEXUS_API_PASSWORD=replace-with-a-long-unique-password
# Generate a unique random value of at least 32 characters.
NEXUS_SESSION_SECRET=replace-with-at-least-32-random-characters
# Require signed browser sessions for FastAPI API and video previews.
NEXUS_AUTH_ENABLED=false
# Keep false for localhost HTTP; enable only behind HTTPS.
NEXUS_COOKIE_SECURE=false

# Isolated host ports; override only if these ports are already in use.
NEXUS_STREAMLIT_HOST_PORT=28502
NEXUS_API_HOST_PORT=28503

# Number of parallel render workers (1-4). Start with 1 on constrained machines.
NEXUS_QUEUE_WORKERS=1

# Hosted SaaS auth is opt-in. Never enable until all hosted routes are tenant-safe.
NEXUS_HOSTED_AUTH_ENABLED=false
# Browser-safe Supabase project URL and publishable key only (never service_role/secret).
NEXUS_SUPABASE_URL=
NEXUS_SUPABASE_PUBLISHABLE_KEY=
# Optional overrides; defaults derive from NEXUS_SUPABASE_URL.
NEXUS_SUPABASE_JWT_ISSUER=
NEXUS_SUPABASE_JWKS_URL=
NEXUS_SUPABASE_JWT_AUDIENCE=authenticated

# Comma-separated HTTPS origins for a separately hosted SaaS frontend.
NEXUS_CORS_ALLOWED_ORIGINS=

# Server-only AES-256-GCM key. Generate with token_vault.generate_encryption_key().
# Never commit this value or send it in chat.
NEXUS_TOKEN_ENCRYPTION_KEY=
NEXUS_TOKEN_ENCRYPTION_KEY_VERSION=v1
# Optional rotation keyring JSON, e.g. {"v1":"<old-key>","v2":"<new-key>"}.
NEXUS_TOKEN_ENCRYPTION_KEYS_JSON=

# Server-only Supabase admin key. Prefer the current opaque sb_secret_* key.
# Legacy service_role JWT remains accepted temporarily for backward compatibility.
NEXUS_SUPABASE_SECRET_KEY=
# Optional legacy fallback; do not set both unless migrating.
NEXUS_SUPABASE_SERVICE_ROLE_KEY=
# Separate Google OAuth Web Application client (not the local Desktop client).
NEXUS_GOOGLE_OAUTH_CLIENT_ID=
NEXUS_GOOGLE_OAUTH_CLIENT_SECRET=
NEXUS_GOOGLE_OAUTH_REDIRECT_URI=
# TikTok Login Kit Web Application client (one NEXUS app shared by all customer accounts).
NEXUS_TIKTOK_CLIENT_KEY=
NEXUS_TIKTOK_CLIENT_SECRET=
NEXUS_TIKTOK_OAUTH_REDIRECT_URI=
# Final HTTPS app origin, e.g. https://app.example.com (no path).
NEXUS_HOSTED_APP_URL=

# Opt-in only. Keep false until hosted auth, service secrets, and quota checks are ready.
NEXUS_HOSTED_WORKER_ENABLED=false
NEXUS_HOSTED_WORKER_POLL_SECONDS=5
NEXUS_HOSTED_WORKER_ID=

# Account deletion is opt-in and requires reviewed migrations plus the dedicated worker.
NEXUS_ACCOUNT_DELETION_ENABLED=false
NEXUS_ACCOUNT_DELETION_WORKER_ENABLED=false
NEXUS_ACCOUNT_DELETION_POLL_SECONDS=20
NEXUS_ACCOUNT_DELETION_WORKER_ID=

# Private YouTube upload only after owner/admin approval. Disabled by default.
NEXUS_HOSTED_UPLOAD_ENABLED=false
NEXUS_HOSTED_UPLOAD_POLL_SECONDS=15
NEXUS_HOSTED_UPLOAD_DAILY_LIMIT=3
NEXUS_HOSTED_UPLOAD_MAX_ATTEMPTS=2
NEXUS_HOSTED_UPLOAD_WORKER_ID=

# Shared public trend collection is opt-in and writes only to Supabase server tables.
NEXUS_TREND_WORKER_ENABLED=false
NEXUS_TREND_WORKER_POLL_SECONDS=21600
NEXUS_TREND_RADAR_DB_PATH=data/studio_data.db
